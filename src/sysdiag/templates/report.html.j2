<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Diagnóstico {{ report.host.hostname }} · {{ report.overall_status }}</title>
<style>
  :root {
    --bg: #f6f7f9; --card: #ffffff; --text: #1d2330; --muted: #5d6677; --border: #dfe3ea;
    --ok: #1f8a4c; --ok-bg: #e3f4ea; --warn: #9a6400; --warn-bg: #fdf1d8;
    --crit: #b42318; --crit-bg: #fde4e1; --error: #5b3fb5; --error-bg: #ece6fb;
    --mono: ui-monospace, "Cascadia Mono", Consolas, "DejaVu Sans Mono", monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #14171d; --card: #1c2028; --text: #e3e7ee; --muted: #9aa3b2; --border: #2c323d;
      --ok: #5fd08f; --ok-bg: #173826; --warn: #f2c063; --warn-bg: #3b2f14;
      --crit: #ff8a7f; --crit-bg: #42201d; --error: #b9a5ff; --error-bg: #2b2443;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
         font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  main { max-width: 1100px; margin: 0 auto; padding: 24px 16px 48px; }
  header { display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: center; justify-content: space-between; }
  h1 { font-size: 1.5rem; margin: 0; }
  h2 { font-size: 1.1rem; margin: 32px 0 12px; }
  .muted { color: var(--muted); }
  .card { background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 16px; }
  .meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; margin-top: 16px; }
  .meta div span { display: block; font-size: .78rem; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
  .meta div strong { font-weight: 600; word-break: break-word; }
  .summary { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
  .badge { display: inline-block; min-width: 56px; text-align: center; padding: 2px 10px; border-radius: 999px;
           font-weight: 700; font-size: .8rem; letter-spacing: .03em; }
  .badge.big { font-size: 1.1rem; padding: 6px 18px; }
  .ok { color: var(--ok); background: var(--ok-bg); }
  .warn { color: var(--warn); background: var(--warn-bg); }
  .crit { color: var(--crit); background: var(--crit-bg); }
  .error { color: var(--error); background: var(--error-bg); }
  .check { margin-bottom: 10px; padding: 0; overflow: hidden; }
  .check summary { display: grid; grid-template-columns: 70px 150px 1fr auto; gap: 12px; align-items: center;
                   padding: 12px 16px; cursor: pointer; list-style: none; }
  .check summary::-webkit-details-marker { display: none; }
  .check summary .name { font-family: var(--mono); font-weight: 600; }
  .check summary .dur { font-family: var(--mono); font-size: .8rem; color: var(--muted); }
  .check .body { border-top: 1px solid var(--border); padding: 12px 16px; overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-size: .88rem; }
  th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--border); vertical-align: top; }
  th { color: var(--muted); font-weight: 600; font-size: .78rem; text-transform: uppercase; }
  td.mono, dd { font-family: var(--mono); font-size: .85rem; }
  dl { display: grid; grid-template-columns: max-content 1fr; gap: 4px 16px; margin: 0 0 12px; }
  dt { color: var(--muted); }
  dd { margin: 0; word-break: break-word; }
  footer { margin-top: 32px; font-size: .8rem; color: var(--muted); }
  @media (max-width: 640px) {
    .check summary { grid-template-columns: 64px 1fr; }
    .check summary .msg { grid-column: 1 / -1; }
    .check summary .dur { display: none; }
  }
  @media print { .check { break-inside: avoid; } details { display: block; } }
</style>
</head>
<body>
<main>
  <header>
    <div>
      <h1>Reporte de diagnóstico</h1>
      <div class="muted">{{ report.host.hostname }} · {{ report.generated_at }}</div>
    </div>
    <span class="badge big {{ report.overall_status | status_class }}">{{ report.overall_status }}</span>
  </header>

  <section class="card meta">
    <div><span>Host</span><strong>{{ report.host.fqdn or report.host.hostname }}</strong></div>
    <div><span>Sistema operativo</span><strong>{{ report.host.os }}</strong></div>
    <div><span>Modo</span><strong>{{ report.host.mode }}</strong></div>
    <div><span>Exit code</span><strong>{{ report.exit_code }}</strong></div>
    <div><span>Duración</span><strong>{{ (report.duration_ms / 1000) | round(1) }} s</strong></div>
    <div><span>Toolkit</span><strong>sysdiag {{ report.host.toolkit_version }}</strong></div>
  </section>

  <div class="summary">
    {% for status, count in report.summary.items() %}
    <span class="badge {{ status | status_class }}">{{ status }}: {{ count }}</span>
    {% endfor %}
  </div>

  <h2>Resultados</h2>
  {% for r in report.results %}
  <details class="card check" {% if r.status != "OK" %}open{% endif %}>
    <summary>
      <span class="badge {{ r.status | status_class }}">{{ r.status }}</span>
      <span class="name">{{ r.name }}</span>
      <span class="msg">{{ r.message }}</span>
      <span class="dur">{{ r.duration_ms | round(0) | int }} ms</span>
    </summary>
    {% if r.details %}
    <div class="body">
      {% set scalars = [] %}
      {% for key, value in r.details.items() if value is not mapping and (value is string or value is not iterable) %}
        {% set _ = scalars.append((key, value)) %}
      {% endfor %}
      {% if scalars %}
      <dl>
        {% for key, value in scalars %}<dt>{{ key }}</dt><dd>{{ value if value is not none else "—" }}</dd>{% endfor %}
      </dl>
      {% endif %}
      {% for key, value in r.details.items() if value is mapping %}
      <dl>
        {% for sub, subvalue in value.items() %}<dt>{{ key }}.{{ sub }}</dt><dd>{{ subvalue if subvalue is not none else "—" }}</dd>{% endfor %}
      </dl>
      {% endfor %}
      {% for key, value in r.details.items() if value is not string and value is iterable and value is not mapping %}
        {% if value and value[0] is mapping %}
        {% set columns = value | columns %}
        <table>
          <thead><tr>{% for c in columns %}<th>{{ c }}</th>{% endfor %}</tr></thead>
          <tbody>
          {% for row in value %}
            <tr>
            {% for c in columns %}
              {% set cell = row.get(c) %}
              {% if c == "status" %}<td><span class="badge {{ cell | status_class }}">{{ cell }}</span></td>
              {% elif cell is not string and cell is iterable and cell is not mapping %}<td class="mono">{{ cell | join(", ") }}</td>
              {% else %}<td class="mono">{{ cell if cell is not none else "—" }}</td>{% endif %}
            {% endfor %}
            </tr>
          {% endfor %}
          </tbody>
        </table>
        {% elif value %}
        <dl><dt>{{ key }}</dt><dd>{{ value | join(", ") }}</dd></dl>
        {% endif %}
      {% endfor %}
    </div>
    {% endif %}
  </details>
  {% endfor %}

  {% if report.skipped %}
  <h2>Checks omitidos</h2>
  <div class="card">
    <table>
      <thead><tr><th>Check</th><th>Motivo</th></tr></thead>
      <tbody>
      {% for s in report.skipped %}<tr><td class="mono">{{ s.name }}</td><td>{{ s.reason }}</td></tr>{% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  <footer>Generado por sysdiag {{ report.host.toolkit_version }} · Python {{ report.host.python }}</footer>
</main>
</body>
</html>
